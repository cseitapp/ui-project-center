# Nuxt private runtime configuration
NUXT_PROJECT_ID=
NUXT_PROJECT_CENTER_PATH=
NUXT_PROJECT_CENTER_API_KEY=
NUXT_FILE_PATH=
NUXT_PIC_PATH=

# Community authentication (runtime-only; never expose through runtimeConfig.public)
# Generate a unique random value of at least 32 characters.
NUXT_SESSION_PASSWORD=
NUXT_AUTH_COOKIE_NAME=community-session
NUXT_COOKIE_LIFE=86400


# Legacy values are used only while invalidating old cookies during migration.
NUXT_AUTH_COOKIE_KEY=
NUXT_LEGACY_AUTH_COOKIE_NAME=
# Set this to the exact Domain used by the legacy cookie, for example .cselao.la.
NUXT_DOMAIN=

# Browser-visible, non-secret runtime configuration
NUXT_PUBLIC_FILE_PATH=
NUXT_PUBLIC_PROJECT_ID=
NUXT_PUBLIC_MENUKEY=
NUXT_PUBLIC_CURRENT_MENUKEY=
NUXT_PUBLIC_LANG_KEY=
